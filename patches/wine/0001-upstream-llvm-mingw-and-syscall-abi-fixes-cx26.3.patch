+#define WRAP_FUNC(name,code) \
+    extern NTSTATUS wrap_##name(void); \
+    __ASM_GLOBAL_FUNC( wrap_##name, code "b " __ASM_NAME(#name) )
+#define ARG1 "and w0, w0, #0xff\n\t"
