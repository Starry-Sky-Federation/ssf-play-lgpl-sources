+#define ARG6 "movzbl %r9b,%r9d\n\t"
+#define ARG7 ARGn(7)
+#define ARG8 ARGn(8)
+#define ARGn(n) "andq $0xff,(" #n "-6)*8(%rsp)\n\t"
+
